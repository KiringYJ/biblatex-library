{
  "name": "ty-marketplace",
  "description": "Local marketplace for ty Python type checker LSP plugin",
  "owner": {
    "name": "local"
  },
  "plugins": [
    {
      "name": "ty-lsp",
      "description": "Python type checking via ty language server",
      "version": "1.0.0",
      "source": "./plugins/ty-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "ty": {
          "command": "ty",
          "args": ["server"],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    }
  ]
}
