{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/identifier_collection.schema.json",
  "title": "Biblio identifier collection",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["main_identifier", "identifiers"],
    "additionalProperties": false,
    "properties": {
      "main_identifier": {
        "type": "string",
        "minLength": 1
      },
      "identifiers": {
        "type": "object",
        "properties": {
          "doi": {"$ref": "#/$defs/identifierValue"},
          "isbn13": {"$ref": "#/$defs/identifierValue"},
          "arxiv": {"$ref": "#/$defs/identifierValue"},
          "url": {"$ref": "#/$defs/identifierValue"},
          "mrnumber": {"$ref": "#/$defs/identifierValue"},
          "zbl": {"$ref": "#/$defs/identifierValue"},
          "zbmath": {"$ref": "#/$defs/identifierValue"},
          "jfm": {"$ref": "#/$defs/identifierValue"},
          "oclc": {"$ref": "#/$defs/identifierValue"},
          "hdl": {"$ref": "#/$defs/identifierValue"},
          "acmdl_doi": {"$ref": "#/$defs/identifierValue"}
        },
        "additionalProperties": {"$ref": "#/$defs/identifierValue"}
      },
      "identifier_alternates": {
        "type": "object",
        "properties": {
          "doi": {"$ref": "#/$defs/alternateValues"},
          "isbn13": {"$ref": "#/$defs/alternateValues"},
          "arxiv": {"$ref": "#/$defs/alternateValues"},
          "url": {"$ref": "#/$defs/alternateValues"},
          "mrnumber": {"$ref": "#/$defs/alternateValues"},
          "zbl": {"$ref": "#/$defs/alternateValues"},
          "zbmath": {"$ref": "#/$defs/alternateValues"},
          "jfm": {"$ref": "#/$defs/alternateValues"},
          "oclc": {"$ref": "#/$defs/alternateValues"},
          "hdl": {"$ref": "#/$defs/alternateValues"},
          "acmdl_doi": {"$ref": "#/$defs/alternateValues"}
        },
        "additionalProperties": {
          "$ref": "#/$defs/alternateValues"
        }
      },
      "key_history": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["key", "main_identifier", "identifier"],
          "additionalProperties": false,
          "properties": {
            "key": {"type": "string", "minLength": 1},
            "main_identifier": {"type": "string", "minLength": 1},
            "identifier": {"$ref": "#/$defs/identifierValue"}
          }
        }
      }
    }
  },
  "$defs": {
    "identifierValue": {
      "type": "string",
      "minLength": 1
    },
    "alternateValues": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifierValue"},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
